# Platform identity only. No OpenAI configuration ever belongs in here —
# a settings profile carries the key, or the host's own `codex login` does.
PLUGIN_ID=
INFRA_CRED=
INFRA_URL=

# Optional, host-level:
# CODEX_EXECUTABLE=/path/to/codex        # when not using the SDK's bundled runtime
# CODEX_WORKSPACE_ROOT=/srv/workspaces   # default fence when no profile sets one
